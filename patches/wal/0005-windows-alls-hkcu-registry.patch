+fn is_sega_property(subkey: &str) -> bool {
+    let trimmed = subkey.trim_start_matches('\\');
+    trimmed.len() >= SYSTEM_PREFIX.len()
+        && trimmed[..SYSTEM_PREFIX.len()].eq_ignore_ascii_case(SYSTEM_PREFIX)
+        && trimmed
+            .as_bytes()
+            .get(SYSTEM_PREFIX.len())
+            .is_none_or(|&b| b == b'\\')
+}
