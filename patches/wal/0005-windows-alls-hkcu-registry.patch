+/// Redirects `HKLM\SYSTEM\SEGA\SystemProperty` opens/creates to HKCU when
+/// unelevated Windows denied writing to HKLM.
+pub(crate) fn install_hooks() {
+    if !USE_HKCU.load(Ordering::Relaxed) {
+        return;
+    }
+    unsafe {
+        for dll in ["advapi32.dll", "api-ms-win-core-registry-l1-1-0.dll"] {
+            if let Some(orig) = iat::hook(dll, "RegOpenKeyExW", reg_open_key_ex_w as *const () as usize) {
+                REG_OPEN_KEY_EX_W.store(orig, Ordering::Relaxed);
+            }
+            if let Some(orig) = iat::hook(dll, "RegOpenKeyExA", reg_open_key_ex_a as *const () as usize) {
+                REG_OPEN_KEY_EX_A.store(orig, Ordering::Relaxed);
+            }
+            if let Some(orig) = iat::hook(dll, "RegCreateKeyExW", reg_create_key_ex_w as *const () as usize) {
+                REG_CREATE_KEY_EX_W.store(orig, Ordering::Relaxed);
+            }
+            if let Some(orig) = iat::hook(dll, "RegCreateKeyExA", reg_create_key_ex_a as *const () as usize) {
+                REG_CREATE_KEY_EX_A.store(orig, Ordering::Relaxed);
+            }
+        }
+    }
+    log!("alls: redirecting HKLM\\{SYSTEM_PREFIX} to HKCU\\{HKCU_PREFIX}{SYSTEM_PREFIX}");
+}
