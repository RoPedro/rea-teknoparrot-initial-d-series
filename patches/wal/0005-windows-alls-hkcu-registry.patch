+/// Redirects `HKLM\SYSTEM\SEGA\SystemProperty` opens/creates/reads to HKCU
+/// when unelevated Windows denies writing to HKLM (both in `amdaemon.exe`
+/// and in the game process itself).
+pub(crate) fn install_hooks() {
+    if !USE_HKCU.load(Ordering::Relaxed) {
+        if can_write_hklm() {
+            return;
+        }
+        USE_HKCU.store(true, Ordering::Relaxed);
+    }
+    let mut hooked = 0usize;
+    unsafe {
+        for dll in [
+            "advapi32.dll",
+            "kernelbase.dll",
+            "api-ms-win-core-registry-l1-1-0.dll",
+        ] {
+            if iat::hook(dll, "RegOpenKeyExW", reg_open_key_ex_w as *const () as usize).is_some() {
+                hooked += 1;
+            }
+            if iat::hook(dll, "RegOpenKeyExA", reg_open_key_ex_a as *const () as usize).is_some() {
+                hooked += 1;
+            }
+            if iat::hook(dll, "RegCreateKeyExW", reg_create_key_ex_w as *const () as usize).is_some() {
+                hooked += 1;
+            }
+            if iat::hook(dll, "RegCreateKeyExA", reg_create_key_ex_a as *const () as usize).is_some() {
+                hooked += 1;
+            }
+            if iat::hook(dll, "RegGetValueW", reg_get_value_w as *const () as usize).is_some() {
+                hooked += 1;
+            }
+            if iat::hook(dll, "RegGetValueA", reg_get_value_a as *const () as usize).is_some() {
+                hooked += 1;
+            }
+        }
+    }
+    log!("alls: redirecting HKLM\\{SYSTEM_PREFIX} to HKCU\\{HKCU_PREFIX}{SYSTEM_PREFIX} ({hooked} IAT hooks)");
+}
