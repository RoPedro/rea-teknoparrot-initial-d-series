+        unsafe { std::mem::transmute(REG_OPEN_KEY_EX_A.load(Ordering::Relaxed)) };
+    if hkey == HKEY_LOCAL_MACHINE && !subkey.is_null() {
+        let len = (0..).take_while(|&i| unsafe { *subkey.add(i) } != 0).count();
+        let s = String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(subkey, len) });
+        if is_sega_property(&s) {
+            let mut redirected = format!("{HKCU_PREFIX}{}", s.trim_start_matches('\\')).into_bytes();
+            redirected.push(0);
+            return unsafe { orig(HKEY_CURRENT_USER, redirected.as_ptr(), options, sam, result) };
+        }
+    }
+    unsafe { orig(hkey, subkey, options, sam, result) }
+}
