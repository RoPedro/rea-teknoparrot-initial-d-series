+unsafe extern "system" fn reg_open_key_ex_w(
+    hkey: HKEY,
+    subkey: *const u16,
+    options: u32,
+    sam: u32,
+    result: *mut HKEY,
+) -> i32 {
+    let orig: unsafe extern "system" fn(HKEY, *const u16, u32, u32, *mut HKEY) -> i32 =
+        unsafe { std::mem::transmute(REG_OPEN_KEY_EX_W.load(Ordering::Relaxed)) };
+    if hkey == HKEY_LOCAL_MACHINE && !subkey.is_null() {
+        let len = (0..).take_while(|&i| unsafe { *subkey.add(i) } != 0).count();
+        let s = String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(subkey, len) });
+        if is_sega_property(&s) {
+            let redirected = wide(&format!("{HKCU_PREFIX}{}", s.trim_start_matches('\\')));
+            return unsafe { orig(HKEY_CURRENT_USER, redirected.as_ptr(), options, sam, result) };
+        }
+    }
+    unsafe { orig(hkey, subkey, options, sam, result) }
+}
