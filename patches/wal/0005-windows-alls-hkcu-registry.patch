+fn can_write_hklm() -> bool {
+    let path = wide(SYSTEM_PREFIX);
+    let mut h: HKEY = std::ptr::null_mut();
+    let rc = unsafe {
+        RegCreateKeyExW(
+            HKEY_LOCAL_MACHINE,
+            path.as_ptr(),
+            0,
+            std::ptr::null(),
+            REG_OPTION_NON_VOLATILE,
+            KEY_WRITE | KEY_WOW64_64KEY,
+            std::ptr::null(),
+            &mut h,
+            std::ptr::null_mut(),
+        )
+    };
+    if rc == 0 {
+        unsafe { RegCloseKey(h) };
+        true
+    } else {
+        false
+    }
+}
