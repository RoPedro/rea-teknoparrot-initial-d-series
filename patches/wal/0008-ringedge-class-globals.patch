new file mode 100644
index 0000000..9dd5887
--- /dev/null
+++ b/crates/payload-ringedge/src/adopt_globals.rs
@@ -0,0 +1,185 @@
+//! A class's singleton global cleared while its object is alive gets that object back
+//! (`WAL_RINGEDGE_ADOPT_GLOBALS`: `method=global` pairs, both addresses relative to the
+//! executable, comma separated).
+//!
+//! Initial D 8: `[0x1463830]` holds the `yabukita` class descriptor of `_sSerial::_sTexture`.
+//! `GetInstance` (`exe+0x754580`, no lock) creates and registers it, but the descriptor's
+//! destructor (`exe+0x754b70`) sets the global to 0 whichever descriptor is destroyed. On
+//! Windows the global was found at 0 while the registered descriptor was alive and making
+//! textures through its factories (`exe+0x7546d0` and `exe+0x754980`, vtable slots 5 and 4):
+//! the texture's constructor reads the descriptor from the global (`exe+0x754846`) and the game
+//! read address 0 (`exe+0x754856`), about 13 s in or when Start was pressed on the card
+//! cleaning screen. Nothing sets the global again, so waiting for it (`wait_globals.rs`)
+//! didn't help: 15 s, still 0.
+//!
+//! Each listed method is a `thiscall` on an object of the class (ecx: the descriptor). Its
+//! entry, `push ebp; mov ebp, esp; push imm8` (5 bytes), becomes a jump to a thunk that calls
+//! [`adopt`] with the global and ecx, all registers and the flags kept, runs those 5 bytes and
+//! jumps back. A global at 0 becomes the object (compare-and-swap); one set, or -1 (being built
+//! by `GetInstance`), is left as is.
+
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use wal_payload_common::log;
+
+/// The prologue a listed method must start with: `push ebp; mov ebp, esp; push imm8`; the
+/// thunk runs it in place of the method.
+fn prologue(code: &[u8]) -> Option<[u8; 5]> {
+    match *code {
+        [0x55, 0x8B, 0xEC, 0x6A, imm, ..] => Some([0x55, 0x8B, 0xEC, 0x6A, imm]),
+        _ => None,
+    }
+}
+
+/// An entry of the option: `(method, global)`, both relative to the executable.
+fn parse_entry(entry: &str) -> Option<(usize, usize)> {
+    let (method, global) = entry.split_once('=')?;
+    let hex = |s: &str| usize::from_str_radix(s.trim().strip_prefix("0x")?, 16).ok();
+    Some((hex(method)?, hex(global)?))
+}
+
+/// `jmp to` written at `at` (5 bytes).
+fn jmp(at: u32, to: u32) -> [u8; 5] {
+    let [a, b, c, d] = to.wrapping_sub(at.wrapping_add(5)).to_le_bytes();
+    [0xE9, a, b, c, d]
+}
+
+/// The thunk at `at` for a method at `method` starting with `entry`: `adopt(global, ecx)`
+/// (cdecl), the registers and flags kept, then `entry` and a jump to `method + 5`.
+fn thunk_bytes(at: u32, method: u32, entry: [u8; 5], global: u32, adopt: u32) -> Vec<u8> {
+    // pushfd; push eax; push edx; push ecx; push ecx (this); push global
+    let mut t = vec![0x9C, 0x50, 0x52, 0x51, 0x51, 0x68];
+    t.extend(global.to_le_bytes());
+    // call adopt
+    t.push(0xE8);
+    let next = at.wrapping_add(t.len() as u32 + 4);
+    t.extend(adopt.wrapping_sub(next).to_le_bytes());
+    // add esp, 8; pop ecx; pop edx; pop eax; popfd
+    t.extend([0x83, 0xC4, 0x08, 0x59, 0x5A, 0x58, 0x9D]);
+    t.extend(entry);
+    let back = jmp(at.wrapping_add(t.len() as u32), method.wrapping_add(5));
+    t.extend(back);
+    t
+}
+
+/// The global at 0 becomes `this`. Whether it did.
+fn adopt_into(global: &AtomicU32, this: u32) -> bool {
+    this != 0 && global.compare_exchange(0, this, Ordering::AcqRel, Ordering::Acquire).is_ok()
+}
+
+/// Hooks the listed methods (`WAL_RINGEDGE_ADOPT_GLOBALS`).
+pub(crate) fn init() {
+    let Ok(list) = std::env::var("WAL_RINGEDGE_ADOPT_GLOBALS") else { return };
+    for entry in list.split(',').filter(|e| !e.trim().is_empty()) {
+        match parse_entry(entry) {
+            Some((method, global)) => install(method, global),
+            None => log!("adopt-globals: {:?} is not method=global (0x...=0x...)", entry.trim()),
+        }
+    }
+}
+
+#[cfg(target_arch = "x86")]
+fn install(method_rva: usize, global_rva: usize) {
+    use windows_sys::Win32::System::Diagnostics::Debug::FlushInstructionCache;
+    use windows_sys::Win32::System::LibraryLoader::GetModuleHandleW;
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEM_RESERVE, PAGE_EXECUTE_READWRITE, VirtualAlloc, VirtualProtect};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+    let base = unsafe { GetModuleHandleW(std::ptr::null()) } as usize;
+    let (method, global) = (base + method_rva, base + global_rva);
+    let code = unsafe { std::slice::from_raw_parts(method as *const u8, 5) };
+    let Some(entry) = prologue(code) else {
+        log!("adopt-globals: +{method_rva:#x} doesn't start with push ebp; mov ebp, esp; push imm8 ({code:02x?}): left as is");
+        return;
+    };
+    let thunk = unsafe { VirtualAlloc(std::ptr::null(), 64, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE) } as usize;
+    if thunk == 0 {
+        log!("adopt-globals: +{method_rva:#x}: no memory for its thunk");
+        return;
+    }
+    let bytes = thunk_bytes(thunk as u32, method as u32, entry, global as u32, adopt as *const () as u32);
+    let hook = jmp(method as u32, thunk as u32);
+    let mut old = 0;
+    unsafe {
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), thunk as *mut u8, bytes.len());
+        VirtualProtect(method as *const _, 5, PAGE_EXECUTE_READWRITE, &mut old);
+        std::ptr::copy_nonoverlapping(hook.as_ptr(), method as *mut u8, hook.len());
+        VirtualProtect(method as *const _, 5, old, &mut old);
+        FlushInstructionCache(GetCurrentProcess(), method as *const _, 5);
+    }
+    log!("adopt-globals: +{method_rva:#x} gives [{global:#x}] its object when it is 0");
+}
+
+#[cfg(not(target_arch = "x86"))]
+fn install(method_rva: usize, _global_rva: usize) {
+    log!("adopt-globals: +{method_rva:#x}: 32-bit games only");
+}
+
+/// The thunks' call: the global at `global` becomes `this` if it is 0.
+#[cfg_attr(not(target_arch = "x86"), allow(dead_code))]
+extern "C" fn adopt(global: usize, this: usize) {
+    let cell = unsafe { &*(global as *const AtomicU32) };
+    if adopt_into(cell, this as u32) {
+        log!("adopt-globals: [{global:#x}] was 0 while {this:#x} was in use: set to it");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn entries_are_method_equals_global() {
+        assert_eq!(parse_entry(" 0x7546d0=0x1063830"), Some((0x7546d0, 0x1063830)));
+        assert_eq!(parse_entry("0x7546d0"), None);
+        assert_eq!(parse_entry("7546d0=0x1063830"), None);
+    }
+
+    #[test]
+    fn only_the_known_prologue_is_hooked() {
+        // Initial D 8, exe+0x7546d0: push ebp; mov ebp, esp; push -1; push 0xed890c
+        assert_eq!(prologue(&[0x55, 0x8B, 0xEC, 0x6A, 0xFF, 0x68]), Some([0x55, 0x8B, 0xEC, 0x6A, 0xFF]));
+        // push ebp; mov ebp, esp; push ecx
+        assert_eq!(prologue(&[0x55, 0x8B, 0xEC, 0x51, 0x89]), None);
+        assert_eq!(prologue(&[0x55, 0x8B]), None);
+    }
+
+    #[test]
+    fn the_thunk_adopts_then_runs_the_entry_and_jumps_back() {
+        let t = thunk_bytes(0x1000, 0xB546D0, [0x55, 0x8B, 0xEC, 0x6A, 0xFF], 0x1463830, 0x5000);
+        assert_eq!(t, [
+            0x9C, 0x50, 0x52, 0x51, 0x51, // pushfd; push eax; push edx; push ecx; push ecx
+            0x68, 0x30, 0x38, 0x46, 0x01, // push 0x1463830
+            0xE8, 0xF1, 0x3F, 0x00, 0x00, // call 0x5000 (from 0x100f)
+            0x83, 0xC4, 0x08, // add esp, 8
+            0x59, 0x5A, 0x58, 0x9D, // pop ecx; pop edx; pop eax; popfd
+            0x55, 0x8B, 0xEC, 0x6A, 0xFF, // the method's entry
+            0xE9, 0xB5, 0x36, 0xB5, 0x00, // jmp 0xb546d5 (from 0x1020)
+        ]);
+    }
+
+    #[test]
+    fn the_method_jumps_to_its_thunk() {
+        assert_eq!(jmp(0xB546D0, 0x0200_0000), [0xE9, 0x2B, 0xB9, 0x4A, 0x01]);
+    }
+
+    #[test]
+    fn a_cleared_global_takes_the_object_in_use() {
+        let g = AtomicU32::new(0);
+        assert!(adopt_into(&g, 0x05FE_CBD8));
+        assert_eq!(g.load(Ordering::Relaxed), 0x05FE_CBD8);
+    }
+
+    #[test]
+    fn a_set_or_building_global_is_left_alone() {
+        let g = AtomicU32::new(0x06A3_9030);
+        assert!(!adopt_into(&g, 0x05FE_CBD8));
+        assert_eq!(g.load(Ordering::Relaxed), 0x06A3_9030);
+        // -1: GetInstance is building the object
+        let g = AtomicU32::new(u32::MAX);
+        assert!(!adopt_into(&g, 0x05FE_CBD8));
+        assert_eq!(g.load(Ordering::Relaxed), u32::MAX);
+        let g = AtomicU32::new(0);
+        assert!(!adopt_into(&g, 0));
+    }
+}
