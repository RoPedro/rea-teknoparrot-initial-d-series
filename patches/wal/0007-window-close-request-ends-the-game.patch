@@ -0,0 +1,53 @@
+//! Which window messages ask a game to quit ([`crate::window`], `WAL_WINDOW_CLOSE`).
+//!
+//! Alt+F4 counts as its key press itself: on a popup made without a system menu
+//! (`WAL_WINDOW_POPUP`) Windows never turns it into `SC_CLOSE` / `WM_CLOSE` (Initial D 8: Alt+F4
+//! left its close flag unset, a `WM_CLOSE` posted to the window set it).
+
+const WM_CLOSE: u32 = 0x10;
+const WM_SYSKEYDOWN: u32 = 0x104;
+const WM_SYSCOMMAND: u32 = 0x112;
+const SC_CLOSE: usize = 0xF060;
+const VK_F4: usize = 0x73;
+/// `WM_SYSKEYDOWN`'s lParam bit 29 (context code): Alt held.
+const ALT_HELD: isize = 1 << 29;
+
+/// Whether the message `msg` (`wparam`, `lparam`) to a top-level window asks the game to quit:
+/// `WM_CLOSE`, the close command (`WM_SYSCOMMAND` `SC_CLOSE`, its low 4 bits the system's) or
+/// Alt+F4 (`WM_SYSKEYDOWN` F4 with Alt held).
+pub(crate) fn is_close_request(msg: u32, wparam: usize, lparam: isize) -> bool {
+    match msg {
+        WM_CLOSE => true,
+        WM_SYSCOMMAND => wparam & 0xFFF0 == SC_CLOSE,
+        WM_SYSKEYDOWN => wparam == VK_F4 && lparam & ALT_HELD != 0,
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WM_KEYDOWN: u32 = 0x100;
+    const ALT: isize = ALT_HELD;
+
+    #[test]
+    fn alt_f4_wm_close_and_the_close_command_ask_to_quit() {
+        assert!(is_close_request(WM_SYSKEYDOWN, VK_F4, ALT | 0x003E_0001));
+        assert!(is_close_request(WM_CLOSE, 0, 0));
+        // SC_CLOSE, its low 4 bits reserved for the system
+        assert!(is_close_request(WM_SYSCOMMAND, 0xF060, 0));
+        assert!(is_close_request(WM_SYSCOMMAND, 0xF063, 0));
+    }
+
+    #[test]
+    fn other_keys_and_commands_do_not() {
+        // F4 without Alt, Alt with another key, a plain F4 key press
+        assert!(!is_close_request(WM_SYSKEYDOWN, VK_F4, 0x003E_0001));
+        assert!(!is_close_request(WM_SYSKEYDOWN, 0x73 + 1, ALT));
+        assert!(!is_close_request(WM_KEYDOWN, VK_F4, 0));
+        // SC_MINIMIZE, SC_KEYMENU (Alt alone)
+        assert!(!is_close_request(WM_SYSCOMMAND, 0xF020, 0));
+        assert!(!is_close_request(WM_SYSCOMMAND, 0xF100, 0));
+    }
+}
