+/// Puts [`close_proc`] in front of a new top-level window's procedure (its ANSI or Unicode
+/// kind kept). Done on the window's own thread inside its `CreateWindowEx`, before it handles
+/// any message: the original is recorded before the window can call [`close_proc`].
+fn end_on_close(hwnd: HWND) {
+    #[cfg(target_pointer_width = "64")]
+    use windows_sys::Win32::UI::WindowsAndMessaging::{SetWindowLongPtrA as set_long_a, SetWindowLongPtrW as set_long_w};
+    #[cfg(target_pointer_width = "32")]
+    use windows_sys::Win32::UI::WindowsAndMessaging::{SetWindowLongA as set_long_a, SetWindowLongW as set_long_w};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{GWLP_WNDPROC, IsWindowUnicode};
+    let unicode = unsafe { IsWindowUnicode(hwnd) } != 0;
+    let mut procs = CLOSE_PROCS.lock().unwrap();
+    if procs.iter().any(|p| p.0 == hwnd as usize) {
+        return;
+    }
+    let ours = close_proc as *const () as usize as _;
+    let orig = unsafe { if unicode { set_long_w(hwnd, GWLP_WNDPROC, ours) } else { set_long_a(hwnd, GWLP_WNDPROC, ours) } } as usize;
+    if orig != 0 {
+        procs.push((hwnd as usize, orig, unicode));
+        log!("window: {hwnd:?}: a close request ends the game");
+    }
+}
+
+/// A close request ([`crate::close_request::is_close_request`]) ends the game at once, as the
+/// launcher's stop does (its saves are written by the launcher afterwards); every other message
+/// goes to the window's own procedure.
+unsafe extern "system" fn close_proc(hwnd: HWND, msg: u32, wparam: usize, lparam: isize) -> isize {
+    use windows_sys::Win32::System::Threading::{GetCurrentProcess, TerminateProcess};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{CallWindowProcA, CallWindowProcW, DefWindowProcW};
+    let Some((orig, unicode)) = CLOSE_PROCS.lock().unwrap().iter().find(|p| p.0 == hwnd as usize).map(|p| (p.1, p.2)) else {
+        return unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) };
+    };
+    if crate::close_request::is_close_request(msg, wparam, lparam) {
+        log!("window: close request (message {msg:#x}, {wparam:#x}) on {hwnd:?}: the game ends");
+        unsafe { TerminateProcess(GetCurrentProcess(), 0) };
+    }
+    unsafe {
+        let orig = Some(std::mem::transmute::<usize, unsafe extern "system" fn(HWND, u32, usize, isize) -> isize>(orig));
+        if unicode { CallWindowProcW(orig, hwnd, msg, wparam, lparam) } else { CallWindowProcA(orig, hwnd, msg, wparam, lparam) }
+    }
+}
+
 type CreateWindow<T> = unsafe extern "system" fn(u32, *const T, *const T, u32, i32, i32, i32, i32, HWND, P, P, P) -> HWND;
 type P = *mut c_void;
 
