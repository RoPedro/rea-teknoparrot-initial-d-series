diff --git a/crates/payload-ringedge/src/hotpatch.rs b/crates/payload-ringedge/src/hotpatch.rs
new file mode 100644
index 0000000..1858157
--- /dev/null
+++ b/crates/payload-ringedge/src/hotpatch.rs
@@ -0,0 +1,51 @@
+//! The order of a hot patch's writes ([`crate::cg::hotpatch`]): a jump to the hook in the 5
+//! padding bytes before the function, the original published, then the short jump at its entry
+//! that makes the hook live.
+//!
+//! The original is published before the hook goes live: other threads may call the function
+//! at once. Windows' loader threads allocate heap while the payload starts; a hook installed
+//! first and given its original afterwards sent one of them to address 0 through
+//! `RtlAllocateHeap` (`WAL_RINGEDGE_ZERO_HEAP`, Initial D 8: a crash at start, now and then,
+//! Windows only).
+
+use std::sync::atomic::{AtomicUsize, Ordering, fence};
+
+/// Hot patches the function at `f` (5 padding bytes before it, a 2 byte prologue) to jump to
+/// `hook`; `orig` receives the original (the function past its prologue) before the hook is
+/// live. `write` stores the bytes at an address (a 2 byte write in one store).
+pub(crate) fn install(f: usize, hook: usize, orig: &AtomicUsize, write: &mut dyn FnMut(usize, &[u8])) {
+    let mut jump = [0xE9, 0, 0, 0, 0];
+    jump[1..].copy_from_slice(&(hook.wrapping_sub(f) as i32).to_le_bytes());
+    write(f - 5, &jump);
+    orig.store(f + 2, Ordering::Release);
+    // the original visible before the entry's jump
+    fence(Ordering::Release);
+    // jmp $-5, written last: one 2 byte store
+    write(f, &[0xEB, 0xF9]);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_original_is_set_before_the_hook_goes_live() {
+        let orig = AtomicUsize::new(0);
+        let mut writes = Vec::new();
+        install(0x1000, 0x5000, &orig, &mut |at, bytes| writes.push((at, bytes.to_vec(), orig.load(Ordering::Acquire))));
+        // the jump to the hook in the padding (0x5000 - 0x1000), then the entry's short jump
+        assert_eq!(writes[0], (0xFFB, vec![0xE9, 0x00, 0x40, 0x00, 0x00], 0));
+        // when the entry's jump is written, any thread may call the hook: it reads the original
+        assert_eq!(writes[1], (0x1000, vec![0xEB, 0xF9], 0x1002));
+        assert_eq!(writes.len(), 2);
+        assert_eq!(orig.load(Ordering::Acquire), 0x1002);
+    }
+
+    #[test]
+    fn a_hook_below_the_function_jumps_back() {
+        let orig = AtomicUsize::new(0);
+        let mut padding = Vec::new();
+        install(0x7000_0000, 0x1000_0000, &orig, &mut |at, bytes| if at != 0x7000_0000 { padding = bytes.to_vec() });
+        assert_eq!(padding, [0xE9, 0x00, 0x00, 0x00, 0xA0]);
+    }
+}
